DATABASE_URL=postgresql://naqi_user:your_password@localhost:5432/naqi_db
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:19000

# Firebase Admin SDK
# Option 1: Use JSON file path (recommended for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Option 2: Use JSON string (for production/environment variables)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# App Store Review Bypass
# Allows Apple reviewers to test OTP flow without receiving real SMS
REVIEWER_PHONE_NUMBER=+15551234567
REVIEWER_OTP_CODE=424242
