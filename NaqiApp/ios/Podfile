# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
else
  # Use static frameworks for Firebase compatibility
  use_frameworks! :linkage => :static
end

# Do NOT enable `use_modular_headers!` here. Under
# `use_frameworks! :linkage => :static` it makes React-Core's `<React/...>`
# imports resolve as `@import`, which strips the RCT_EXTERN / RCT_EXPORT_*
# macros that React Native Firebase relies on. The remaining fixes for the
# RNFBMessaging module-wall / macro-visibility errors live in
# patches/@react-native-firebase+messaging+25.1.0.patch and
# patches/react-native+0.85.3.patch.

target 'NaqiApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Fix for C++20 consteval issues with newer Xcode/iOS SDK
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Downgrade C++ language standard for problematic pods
        if ['fmt', 'Yoga', 'glog'].include?(target.name)
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end

        # Add compiler flags to suppress consteval errors
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= ['$(inherited)']
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-Wno-error=invalid-constexpr'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-Wno-invalid-constexpr'

        # Allow non-modular includes in framework modules (needed for RNFBApp
        # to include React-Core headers like RCTConvert.h under static frameworks).
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # Fix for React Native Firebase module import issues
        if target.name.start_with?('RNFB')
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
          config.build_settings['DEFINES_MODULE'] = 'YES'
        end
      end
    end

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
